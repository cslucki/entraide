APP_NAME=BouclePro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
DB_CONNECTION=sqlite

# Session / cache / queue
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# TASK-1839 — pilote Laravel Reverb (LoopChat uniquement), LOCAL seulement.
# BROADCAST_CONNECTION reste `log` ci-dessus par defaut : decommenter ce
# bloc ET poser BROADCAST_CONNECTION=reverb UNIQUEMENT pour lancer le
# serveur local `php artisan reverb:start` et recetter le pilote.
# LOOP_CHAT_REALTIME_ENABLED (config/loop_chat.php, cote PHP) ET
# VITE_LOOP_CHAT_REALTIME_ENABLED (cote navigateur, resources/js/echo.js)
# restent FAUX tant qu'ils ne sont pas poses explicitement : sans eux,
# `window.Echo` n'est JAMAIS instancie et aucune connexion WebSocket n'est
# tentee — c'est l'etat de cette ligne, celui de PROD aujourd'hui.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8080
# REVERB_SCHEME=http
# REVERB_SERVER_HOST=127.0.0.1
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST=test.laravel
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
# TASK-1850 — timeouts courts pour la connexion de diffusion `reverb`
# (config/broadcasting.php) : sous QUEUE_CONNECTION=sync, un appel
# broadcast() bloque la requete HTTP de l'utilisateur jusqu'a sa
# resolution. Defauts raisonnables deja poses dans le code (1.0/2.0s) ;
# decommenter uniquement pour ajuster sans toucher au code.
# REVERB_CLIENT_CONNECT_TIMEOUT=1.0
# REVERB_CLIENT_TIMEOUT=2.0
# LOOP_CHAT_REALTIME_ENABLED=false
# VITE_LOOP_CHAT_REALTIME_ENABLED="${LOOP_CHAT_REALTIME_ENABLED}"

# TASK-1843 — pilote Reverb sur le badge de notifications internes, meme
# connexion `window.Echo` que ci-dessus mais DRAPEAU INDEPENDANT du pilote
# ChatLoop : chacun s'active separement, les deux restent FAUX par defaut.
# NOTIFICATIONS_REALTIME_ENABLED=false
# VITE_NOTIFICATIONS_REALTIME_ENABLED="${NOTIFICATIONS_REALTIME_ENABLED}"

# TASK-1845/1846 — pilote Reverb sur les messages de conversation privee
# (diffusion serveur TASK-1845, reception+polling adaptatif navigateur
# TASK-1846). Troisieme drapeau INDEPENDANT des deux precedents, meme
# connexion `window.Echo` partagee, FAUX par defaut.
# CONVERSATION_REALTIME_ENABLED=false
# VITE_CONVERSATION_REALTIME_ENABLED="${CONVERSATION_REALTIME_ENABLED}"

# TASK-1847 — pilote Reverb sur le compteur GLOBAL de messages non lus
# (`User::unreadMessagesCount()`). Quatrieme drapeau INDEPENDANT des trois
# precedents, meme connexion `window.Echo` partagee, FAUX par defaut. A NE
# PAS CONFONDRE avec NOTIFICATIONS_REALTIME_ENABLED (`MemberNotification`,
# un modele de donnees different).
# MESSAGES_UNREAD_REALTIME_ENABLED=false
# VITE_MESSAGES_UNREAD_REALTIME_ENABLED="${MESSAGES_UNREAD_REALTIME_ENABLED}"

# Mail
# Local default: write emails to logs.
# Configure SMTP or another supported mailer only in the private environment.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Adresse de l'INTERFACE MailHog en developpement local (TASK-1376).
# La sonde du diagnostic reste figee sur 127.0.0.1 dans le code ; cette valeur
# ne sert QU'au lien affiche, ouvert depuis le navigateur. Sous WSL, les deux
# ne sont pas a la meme adresse. Non secrete.
# MAILHOG_UI_URL=http://127.0.0.1:8025

VITE_APP_NAME="${APP_NAME}"

# AI
# Provider credentials and production settings belong in the private environment.
AI_SUPERVISION_ENABLED=false
AI_CLARIFY_ENABLED=false

# Shell Welcome (visiteur) — plafond de depense PLATEFORME, en USD, par mois.
# Requis pour activer le Shell Guest paye : absent, vide ou <= 0, la garde
# refuse AVANT tout appel au fournisseur (fail-closed, `platform_ceiling_unset`).
# Ce n'est pas un secret, et c'est pourquoi la cle figure ici. Mais aucune
# valeur par defaut n'est proposee : le montant est une decision economique,
# pas une convention technique — l'inventer serait engager une depense.
AI_GUEST_SHELL_PLATFORM_CEILING_USD=

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

OPENAI_SUPERVISION_ENABLED=false
OPENAI_API_KEY=

# Dossier semantic search
DOSSIER_SEMANTIC_SEARCH_ENABLED=false
DOSSIER_SEMANTIC_SEARCH_ORGANIZATION_IDS=

# Cloudflare Turnstile — captcha a l'ENTREE de l'inscription (TASK-1713).
#
# `false` par defaut, et ce defaut est delibere : la PROD ne porte aucune de ces
# variables, et un defaut `true` fermerait l'inscription a la seconde ou le code
# arrive. La fonctionnalite part dormante ; l'activer est un geste
# d'environnement. C'est aussi le coupe-circuit d'incident : le verificateur est
# fail-closed (Cloudflare injoignable = inscription refusee), et c'est tenable
# precisement parce que cette variable l'eteint sans deploiement.
#
# TURNSTILE_SITE_KEY n'est PAS un secret : Cloudflare la publie dans le HTML du
# widget. TURNSTILE_SECRET_KEY en est un, et ne quitte jamais le serveur.
# Les deux se creent par widget dans le tableau de bord Cloudflare, ou la liste
# des noms d'hote autorises est declaree.
#
# Cles generiques officielles pour un banc de test, publiques et documentees
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/) :
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA          # passe toujours
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=false

# TASK-1837 — second drapeau, pour le LOGIN (/login, /org/{slug}/login).
#
# Volontairement SEPARE de TURNSTILE_ENABLED ci-dessus : meme site_key/
# secret_key (meme site Cloudflare), mais une activation INDEPENDANTE.
# Un incident sur le login ne doit pas obliger a couper aussi le captcha de
# l'inscription, et inversement. `false` par defaut, pour la meme raison
# que TURNSTILE_ENABLED : la fonctionnalite part dormante.
TURNSTILE_LOGIN_ENABLED=false

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# TASK-1739 — Web Push : identite VAPID du serveur (RFC 8292).
#
# Generer une paire PAR ENVIRONNEMENT, jamais la partager. Les abonnements
# d'un navigateur sont lies a la clef publique qui les a crees : changer de
# paire invalide tous les abonnements existants.
#
# VAPID_PRIVATE_KEY est SECRETE : jamais commitee, jamais journalisee, jamais
# servie au navigateur. Seule la clef publique part cote client.
#
# Generation sans dependance Composer :
#   openssl ecparam -genkey -name prime256v1 -noout -out vapid.pem
#   # publique  (87 car., point non compresse, 1er octet 0x04) :
#   openssl ec -in vapid.pem -pubout -outform DER | tail -c 65 | base64 -w0 | tr '+/' '-_' | tr -d '='
#   # privee    (43 car., scalaire 32 octets) :
#   openssl ec -in vapid.pem -outform DER | tail -c +8 | head -c 32 | base64 -w0 | tr '+/' '-_' | tr -d '='
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Faux par defaut : une variable absente n'allume pas une fonctionnalite.
WEB_PUSH_ENABLED=false

# TASK-1895 — Application Android (TWA), servie par /.well-known/assetlinks.json.
# Empreintes SHA-256 des certificats de signature, separees par des virgules,
# format AA:BB:... (32 octets) : clef de signature Google Play (Play Console >
# Integrite de l'application) et, pour la recette, clef d'envoi. Donnees
# publiques, pas des secrets. Vide = la route rend [] (aucune delegation).
ANDROID_TWA_PACKAGE=com.bouclepro.app
ANDROID_TWA_SHA256_CERT_FINGERPRINTS=

# TASK-1832 — FAUX par defaut : sous QUEUE_CONNECTION=sync, le balayage
# planifie `knowledge:derive-due` executerait ses jobs EN LIGNE dans le
# Scheduler, sans strategie asynchrone validee. `php artisan knowledge:derive-due`
# reste executable a la main quelle que soit cette valeur.
KNOWLEDGE_DERIVE_DUE_SCHEDULED_ENABLED=false
