APP_NAME=BouclePro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
DB_CONNECTION=sqlite

# Session / cache / queue
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail
# Local default: write emails to logs.
# Configure SMTP or another supported mailer only in the private environment.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Adresse de l'INTERFACE MailHog en developpement local (TASK-1376).
# La sonde du diagnostic reste figee sur 127.0.0.1 dans le code ; cette valeur
# ne sert QU'au lien affiche, ouvert depuis le navigateur. Sous WSL, les deux
# ne sont pas a la meme adresse. Non secrete.
# MAILHOG_UI_URL=http://127.0.0.1:8025

VITE_APP_NAME="${APP_NAME}"

# AI
# Provider credentials and production settings belong in the private environment.
AI_SUPERVISION_ENABLED=false
AI_CLARIFY_ENABLED=false

# Shell Welcome (visiteur) — plafond de depense PLATEFORME, en USD, par mois.
# Requis pour activer le Shell Guest paye : absent, vide ou <= 0, la garde
# refuse AVANT tout appel au fournisseur (fail-closed, `platform_ceiling_unset`).
# Ce n'est pas un secret, et c'est pourquoi la cle figure ici. Mais aucune
# valeur par defaut n'est proposee : le montant est une decision economique,
# pas une convention technique — l'inventer serait engager une depense.
AI_GUEST_SHELL_PLATFORM_CEILING_USD=

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

OPENAI_SUPERVISION_ENABLED=false
OPENAI_API_KEY=

# Dossier semantic search
DOSSIER_SEMANTIC_SEARCH_ENABLED=false
DOSSIER_SEMANTIC_SEARCH_ORGANIZATION_IDS=

# Cloudflare Turnstile — captcha a l'ENTREE de l'inscription (TASK-1713).
#
# `false` par defaut, et ce defaut est delibere : la PROD ne porte aucune de ces
# variables, et un defaut `true` fermerait l'inscription a la seconde ou le code
# arrive. La fonctionnalite part dormante ; l'activer est un geste
# d'environnement. C'est aussi le coupe-circuit d'incident : le verificateur est
# fail-closed (Cloudflare injoignable = inscription refusee), et c'est tenable
# precisement parce que cette variable l'eteint sans deploiement.
#
# TURNSTILE_SITE_KEY n'est PAS un secret : Cloudflare la publie dans le HTML du
# widget. TURNSTILE_SECRET_KEY en est un, et ne quitte jamais le serveur.
# Les deux se creent par widget dans le tableau de bord Cloudflare, ou la liste
# des noms d'hote autorises est declaree.
#
# Cles generiques officielles pour un banc de test, publiques et documentees
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/) :
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA          # passe toujours
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
