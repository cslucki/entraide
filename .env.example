APP_NAME=BouclePro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------
# BASE DE DONNÉES
# ---------------------------------------------------------
# Dev local : copier .env.sqlite → .env
# Prod (Laravel Cloud) : PostgreSQL 18 (variables injectées automatiquement)
DB_CONNECTION=sqlite

# ---------------------------------------------------------
# SESSION / CACHE / QUEUE
# ---------------------------------------------------------
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Public filesystem URL (defaults to APP_URL/storage).
# Set to /storage for multi-host local dev (mobile + desktop same server).
FILESYSTEM_PUBLIC_URL=

# ---------------------------------------------------------
# EMAILS — SMTP Relai-SMTP recommandé pour la production
# ---------------------------------------------------------
# Développement local : MAIL_MAILER=log (les emails sont écrits dans les logs).
# Production : MAIL_MAILER=smtp avec les credentials Relai-SMTP ci-dessous.
# Resend est également supporté (MAIL_MAILER=resend + RESEND_KEY) si configuré.
MAIL_MAILER=log

# SMTP Relai-SMTP (transport plateforme par défaut en production)
# MAIL_HOST=smtp.relai-smtp.net
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=ssl

MAIL_FROM_ADDRESS="noreply@bouclepro.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------
# IA — Providers configurables (lab admin)
# ---------------------------------------------------------
# AI_PROVIDER=openrouter  → principal (multi-modèle)
# Ollama → local (recommandé en dev)
# OpenAI → supervision admin (désactivé par défaut)
AI_SUPERVISION_ENABLED=true
AI_CLARIFY_ENABLED=true

# OPENROUTER — Multi-model proxy (provider par défaut)
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# OLLAMA — Local LLM (alternative locale)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ministral-3:3b
OLLAMA_TIMEOUT=30

# OPENAI — Supervision admin (opt-in uniquement)
OPENAI_SUPERVISION_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_TIMEOUT=15

# LARAVEL AI SDK — Dossier semantic search embeddings (disabled by default)
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_CACHE_ENABLED=false
DOSSIER_SEMANTIC_SEARCH_ENABLED=false
DOSSIER_SEMANTIC_SEARCH_ORGANIZATION_IDS=

# ---------------------------------------------------------
# DOSSIER FILES STORAGE — Driver configuration
# ---------------------------------------------------------
# DOSSIER_FILES_DRIVER=local        # local (default) | s3
# AWS_ACCESS_KEY_ID=                # required when DOSSIER_FILES_DRIVER=s3
# AWS_SECRET_ACCESS_KEY=            # required when DOSSIER_FILES_DRIVER=s3
# AWS_DEFAULT_REGION=               # required when DOSSIER_FILES_DRIVER=s3
# AWS_BUCKET=                       # required when DOSSIER_FILES_DRIVER=s3
# AWS_ENDPOINT=                     # required when DOSSIER_FILES_DRIVER=s3
# AWS_USE_PATH_STYLE_ENDPOINT=false # optional

# ---------------------------------------------------------
# AI BUDGET ALERTS — Monthly cost thresholds per scenario
# ---------------------------------------------------------
AI_BUDGET_SUPERVISION_CONTENT=5.00
AI_BUDGET_CLARIFY_HELP_REQUEST=2.00
CHATLOOP_AI_SUMMARY_MONTHLY_BUDGET_USD=2.00
CHATLOOP_AI_SUMMARY_MONTHLY_UNKNOWN_LIMIT=10
