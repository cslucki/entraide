# =========================================================
# ENVIRONNEMENT DE VALIDATION IA — TASK-1201
# =========================================================
# Modèle SANS secret, à copier vers un fichier local non tracké avant tout
# usage réel :
#
#   cp .env.ai-validation.example .env.ai-validation
#   # puis éditer .env.ai-validation : remplacer les REPLACE_ME
#
# Ne JAMAIS committer .env.ai-validation (déjà couvert par .gitignore : .env.*).
# Ne JAMAIS copier ce fichier vers .env — il reste un fichier séparé, chargé
# explicitement par les scripts serveur/worker dédiés
# (ai/scripts/ai-validation-serve.sh, ai/scripts/ai-validation-worker.sh).
#
# DB_CONNECTION pointe sur la connexion nommée "bouclepro_ai_validation"
# (config/database.php) dont le nom de base est un LITTÉRAL non
# surchargeable — voir App\Support\AiValidation\AiValidationDatabaseGuard.
# =========================================================

APP_NAME="BouclePro AI Validation"
APP_ENV=local
APP_KEY=REPLACE_ME_WITH_A_GENERATED_KEY
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------
# BASE DE DONNÉES — connexion dédiée, jamais bouclepro/bouclepro_test
# ---------------------------------------------------------
# DB_CONNECTION doit rester exactement "bouclepro_ai_validation" : c'est la
# seule valeur acceptée par AiValidationDatabaseGuard. Les identifiants de
# connexion (hôte/port/utilisateur/mot de passe) sont configurables via les
# variables AI_VALIDATION_DB_* ci-dessous ; le NOM de la base ne l'est pas
# (littéral dans config/database.php, par sécurité).
DB_CONNECTION=bouclepro_ai_validation
AI_VALIDATION_DB_HOST=127.0.0.1
AI_VALIDATION_DB_PORT=5432
AI_VALIDATION_DB_USERNAME=bouclepro
AI_VALIDATION_DB_PASSWORD=REPLACE_ME

# ---------------------------------------------------------
# SESSION / CACHE / QUEUE
# ---------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_PUBLIC_URL=/storage

# ---------------------------------------------------------
# EMAILS — jamais d'envoi réel dans cet environnement
# ---------------------------------------------------------
MAIL_MAILER=log

# ---------------------------------------------------------
# IA — désactivée par défaut ; activer ponctuellement pour un scénario
# précis une fois PostgreSQL/pgvector disponibles (voir TASK-1201)
# ---------------------------------------------------------
AI_SUPERVISION_ENABLED=false
AI_CLARIFY_ENABLED=false
OLLAMA_ENABLED=false
OPENROUTER_ENABLED=false
OPENAI_SUPERVISION_ENABLED=false

# ---------------------------------------------------------
# COMPTES DE VALIDATION — voir AiValidationDatasetSeeder (TASK-1201)
# Mot de passe unique pour tous : password
# ---------------------------------------------------------
AI_VALIDATION_ORG_A_ADMIN_LOGIN=admin@ai-validation-org-a.ai-validation.test
AI_VALIDATION_ORG_A_MEMBER1_LOGIN=member1@ai-validation-org-a.ai-validation.test
AI_VALIDATION_ORG_A_MEMBER2_LOGIN=member2@ai-validation-org-a.ai-validation.test

AI_VALIDATION_ORG_B_ADMIN_LOGIN=admin@ai-validation-org-b.ai-validation.test
AI_VALIDATION_ORG_B_MEMBER1_LOGIN=member1@ai-validation-org-b.ai-validation.test
AI_VALIDATION_ORG_B_MEMBER2_LOGIN=member2@ai-validation-org-b.ai-validation.test

AI_VALIDATION_PASSWORD=password
